!!ARBvp1.0
# rsx_cube's vertex program: diffuse lighting per vertex. c[0..3]: the model-view-projection
# matrix's rows; c[4..6]: the rotation's, for normals; c[7]: the light direction, with w = 1 for
# the color's alpha; c[8]: the ambient light, with w = 0 as the floor of the diffuse term.
DP4 result.position.x, c[0], vertex.position;
DP4 result.position.y, c[1], vertex.position;
DP4 result.position.z, c[2], vertex.position;
DP4 result.position.w, c[3], vertex.position;
DP3 R0.x, c[4], vertex.normal;
DP3 R0.y, c[5], vertex.normal;
DP3 R0.z, c[6], vertex.normal;
DP3 R1, R0, c[7];
MAX R1, R1, c[8].w;
ADD result.color.xyz, R1, c[8];
MOV result.color.w, c[7].w;
MOV result.texcoord[0], vertex.texcoord[0];
END
